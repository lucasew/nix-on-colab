#!/usr/bin/env python3
"""Script to reconstruct the environment inside the non-root Colab user."""

from getpass import getuser
from sys import argv, stdin, stdout, stderr
from json import load
from subprocess import Popen
from os import environ

if getuser() == "root":
    raise RuntimeError("This script can't be run as root")

FILENAME = argv[1]


def append_var(target_env, key, sep=":"):
    """Append a value to an environment variable."""
    parts = []
    if key in ("LD_LIBRARY_PATH", "LIBRARY_PATH"):
        parts.append(f"{target_env.get('HOME')}/.nix-profile/lib")
    if key == "PATH":
        parts.append(f"{target_env.get('HOME')}/.nix-profile/bin")
    if key == "MANPATH":
        parts.append(f"{target_env.get('HOME')}/.nix-profile/share/man")
    if environ.get(key) is not None:
        parts.append(environ[key])
    if target_env.get(key) is not None:
        parts.append(target_env[key])
    target_env[key] = sep.join(parts)
    return target_env


with open(FILENAME, "r", encoding="utf-8") as f:
    args = load(f)
    env = args["env"]
    env["HOME"] = "/content/user"
    env = append_var(env, "__EGL_VENDOR_LIBRARY_DIRS")
    env = append_var(env, "LD_LIBRARY_PATH")
    env = append_var(env, "LIBRARY_PATH")
    env = append_var(env, "PATH")
    env = append_var(env, "MANPATH")
    env.pop("LD_PRELOAD", None)
    with Popen(args["argv"], env=env, stdin=stdin, stdout=stdout, stderr=stderr) as p:
        p.wait()
